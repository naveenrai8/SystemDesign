    {
      "id": "s9vkMChV5gSlKYgM9nQEU",
      "type": "text",
      "x": 2382.3208632357946,
      "y": 7991.119948345291,
      "width": 303.2654873213862,
      "height": 302.40000000000003,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "Veu59sx9ApOZXyprOgqwJ"
      ],
      "frameId": null,
      "index": "b9V",
      "roundness": null,
      "seed": 1785770027,
      "version": 1891,
      "versionNonce": 144836971,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776430169704,
      "link": null,
      "locked": false,
      "text": "- CDN call lands to Short Url service\n- fetches the mapping from the cache \n    - cache miss\n    - try to get the lock\n    - if not acquired, do exponentail backoff\nwith jitter\n    - else, \n        - get the mapping from the short_url\ntable\n        - update the cache\n- check in malicious url cache\n    - if long url is malicious, return 500\n    - else \n        - return to long url to the CDN",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- CDN call lands to Short Url service\n- fetches the mapping from the cache \n    - cache miss\n    - try to get the lock\n    - if not acquired, do exponentail backoff with jitter\n    - else, \n        - get the mapping from the short_url table\n        - update the cache\n- check in malicious url cache\n    - if long url is malicious, return 500\n    - else \n        - return to long url to the CDN",
      "autoResize": false,
      "lineHeight": 1.35
    },
