      "link": null,
      "locked": false,
      "text": "- call lands to Short Url service\n- fetches the mapping from the cache if\npresent\n- return the long url to the short Url\nservice\n- redirect the user by setting Location\nheader in the response.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- call lands to Short Url service\n- fetches the mapping from the cache if present\n- return the long url to the short Url service\n- redirect the user by setting Location header in the response.",
      "autoResize": false,
      "lineHeight": 1.35
    },
