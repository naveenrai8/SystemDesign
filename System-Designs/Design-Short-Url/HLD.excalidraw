    {
      "id": "q6q25pKiCss0Wclx-oDrS",
      "type": "text",
      "x": -86.33888728329396,
      "y": 3670.3024912243236,
      "width": 303.2654873213862,
      "height": 302.40000000000003,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "B2RemFbidcSdO2dgagb32"
      ],
      "frameId": null,
      "index": "b3T",
      "roundness": null,
      "seed": 1693181707,
      "version": 1277,
      "versionNonce": 494019365,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776428531659,
      "link": null,
      "locked": false,
      "text": "- call lands to Short Url service\n- fetches the mapping from the cache \n    - cache miss\n    - try to get the lock\n    - if not acquired, do exponentail backoff\nwith jitter\n    - else, \n        - get the mapping from the short_url\ntable\n        - update the cache\n- return the long url to the short Url\nservice\n- redirect the user by setting Location\nheader in the response.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- call lands to Short Url service\n- fetches the mapping from the cache \n    - cache miss\n    - try to get the lock\n    - if not acquired, do exponentail backoff with jitter\n    - else, \n        - get the mapping from the short_url table\n        - update the cache\n- return the long url to the short Url service\n- redirect the user by setting Location header in the response.",
      "autoResize": false,
      "lineHeight": 1.35
    },
