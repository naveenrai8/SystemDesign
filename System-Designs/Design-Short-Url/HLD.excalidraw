    {
      "id": "choJy9jWqJbvUDUaQEUMO",
      "type": "text",
      "x": 2154.9832089174324,
      "y": 6339.3724979427,
      "width": 303.2654873213862,
      "height": 302.40000000000003,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "jQ0Vvc0j-7gvBtA-eGyav"
      ],
      "frameId": null,
      "index": "b7w",
      "roundness": null,
      "seed": 111877669,
      "version": 1666,
      "versionNonce": 1265789989,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776429750587,
      "link": null,
      "locked": false,
      "text": "- CDN call lands to Short Url service\n- fetches the mapping from the cache \n    - cache miss\n    - try to get the lock\n    - if not acquired, do exponentail backoff\nwith jitter\n    - else, \n        - get the mapping from the short_url\ntable\n        - update the cache\n- return the long url to the short Url\nservice\n- redirect the user by setting Location\nheader in the response.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- CDN call lands to Short Url service\n- fetches the mapping from the cache \n    - cache miss\n    - try to get the lock\n    - if not acquired, do exponentail backoff with jitter\n    - else, \n        - get the mapping from the short_url table\n        - update the cache\n- return the long url to the short Url service\n- redirect the user by setting Location header in the response.",
      "autoResize": false,
      "lineHeight": 1.35
    },
