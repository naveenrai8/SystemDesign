      "seed": 1798226795,
      "version": 1393,
      "versionNonce": 1431452293,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776428807153,
      "link": null,
      "locked": false,
      "text": "- call lands to Short Url service\n- identify if key is marked as hot_key\n    - create key = shorturl_<salting>\n    - fetches the mapping from the cache\nthrough proxy\n- return the long url to the short Url\nservice\n- redirect the user by setting Location\nheader in the response.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- call lands to Short Url service\n- identify if key is marked as hot_key\n    - create key = shorturl_<salting>\n    - fetches the mapping from the cache through proxy\n- return the long url to the short Url service\n- redirect the user by setting Location header in the response.",
      "autoResize": false,
      "lineHeight": 1.35
    },
